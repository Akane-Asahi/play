{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && !newData.exists() && (root.child('rooms/' + $code + '/meta/host').val() === auth.uid || root.child('roomIndex/' + $code).val() < now)",
        "meta": {
          ".read": "auth != null",
          "$field": {
            ".write": "auth != null && newData.parent().child('host').val() === auth.uid"
          }
        },
        "players": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && ($pid === auth.uid || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)"
          }
        },
        "hands": {
          "$pid": {
            ".read": "auth != null && ($pid === auth.uid || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)",
            ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid"
          }
        },
        "secret": {
          ".read": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid"
        },
        "game": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists()"
        },
        "shown": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          "$viewer": {
            ".read": "auth != null && ($viewer === auth.uid || ($viewer.beginsWith('bot-') && root.child('rooms/' + $code + '/meta/host').val() === auth.uid))",
            "$n": {
              ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists()"
            }
          }
        }
      }
    },
    "roomIndex": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && ((!newData.exists() && (root.child('rooms/' + $code + '/meta/host').val() === auth.uid || data.val() < now)) || (root.child('rooms/' + $code + '/meta/host').val() === auth.uid && newData.isNumber() && newData.val() <= now + 90000000 && newData.val() > now - 600000))"
      }
    }
  }
}
